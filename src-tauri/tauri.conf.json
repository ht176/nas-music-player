{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAS Music Player",
  "version": "1.0.5",
  "identifier": "com.nas.music.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NAS Music Player",
        "width": 1100,
        "height": 720,
        "minWidth": 320,
        "minHeight": 120,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0Q0IzNjVBRTI3QUFBNzYKUldSMnFucmlXamJMTkhxdC9ITU9LcTM0dmF2Uk1FNFduaGRuUUhPc3NoUHRubEpqOGZjcVFyTW0K",
      "endpoints": [
        "https://github.com/ht176/nas-music-player/releases/latest/download/latest.json"
      ]
    }
  }
}
